#AI-Powered Sales Insights (FINAL WORKING VERSION)

import pandas as pd
import matplotlib.pyplot as plt

# -----------------------------
# ✅ Load dataset 
# -----------------------------
df = pd.read_csv('https://raw.githubusercontent.com/selva86/datasets/master/Superstore.csv')

# Clean data
df = df.dropna()

# Check columns (debug safety)
print("Columns:", df.columns)

# Show sample
print("\nSample Data:")
print(df.head())

# -----------------------------
# 📊 Sales by Region
# -----------------------------
region_sales = df.groupby('Region')['Sales'].sum()

plt.figure()
region_sales.plot(kind='bar')
plt.title('Sales by Region')
plt.xlabel('Region')
plt.ylabel('Sales')
plt.show()

# -----------------------------
# 📊 Profit by Region
# -----------------------------
region_profit = df.groupby('Region')['Profit'].sum()

plt.figure()
region_profit.plot(kind='bar')
plt.title('Profit by Region')
plt.xlabel('Region')
plt.ylabel('Profit')
plt.show()

# -----------------------------
# 📊 Discount vs Profit
# -----------------------------
plt.figure()
plt.scatter(df['Discount'], df['Profit'])
plt.title('Discount vs Profit')
plt.xlabel('Discount')
plt.ylabel('Profit')
plt.show()

# -----------------------------
# 🤖 AI Insight Generator
# -----------------------------
def generate_insights(df):
    insights = []
    
    top_region = df.groupby('Region')['Sales'].sum().idxmax()
    insights.append(f"Top performing region is {top_region}")
    
    avg_discount = df['Discount'].mean()
    if avg_discount > 0.15:
        insights.append("Discount levels are impacting profitability")
    
    avg_profit = df['Profit'].mean()
    insights.append(f"Average profit per transaction is {round(avg_profit,2)}")
    
    top_category = df.groupby('Category')['Sales'].sum().idxmax()
    insights.append(f"Top selling category is {top_category}")
    
    return insights

print("\n🤖 AI GENERATED INSIGHTS:")
ai_insights = generate_insights(df)

for i in ai_insights:
    print("-", i)

# -----------------------------
# 📊 Sales Distribution
# -----------------------------
plt.figure()
plt.hist(df['Sales'])
plt.title('Sales Distribution')
plt.xlabel('Sales')
plt.ylabel('Frequency')
plt.show()
